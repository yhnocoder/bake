{
  "name": "bake",
  "displayName": "Bake",
  "description": "Preview the articles of a Bake blog next to the editor, with problems, completions and highlighting for Bake's Markdown syntax",
  "version": "0.2.0",
  "publisher": "yhnocoder",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/yhnocoder/bake/tree/main/editors/vscode#readme",
  "bugs": "https://github.com/yhnocoder/bake/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhnocoder/bake.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "bake",
    "blog",
    "markdown",
    "preview",
    "static site generator"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "completions.js",
    "syntaxes",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bake.openPreview",
        "title": "Open Preview to the Side",
        "category": "Bake",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bake.openPreview",
          "when": "resourceFilename == index.md",
          "group": "navigation"
        }
      ]
    },
    "grammars": [
      {
        "scopeName": "markdown.bake.injection",
        "path": "./syntaxes/bake.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ]
  }
}

<h2 id="math"><a class="anchor" href="#math" aria-hidden="true">#</a>公式</h2>
<p>行内公式 <span class="math" data-tex="E = mc^2"><svg style="vertical-align: -0.025ex;" xmlns="http://www.w3.org/2000/svg" width="8.704ex" height="1.912ex" role="img" focusable="false" viewBox="0 -833.9 3847.1 844.9"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="scale(1,-1)"><g data-mml-node="math"><g data-mml-node="mi"><use data-c="1D438" href="#MJX-NCM-I-1D438"></use></g><g data-mml-node="mo" transform="translate(1043.8,0)"><use data-c="3D" href="#MJX-NCM-N-3D"></use></g><g data-mml-node="mi" transform="translate(2099.6,0)"><use data-c="1D45A" href="#MJX-NCM-I-1D45A"></use></g><g data-mml-node="msup" transform="translate(2977.6,0)"><g data-mml-node="mi"><use data-c="1D450" href="#MJX-NCM-I-1D450"></use></g><g data-mml-node="mn" transform="translate(466,363) scale(0.707)"><use data-c="32" href="#MJX-NCM-N-32"></use></g></g></g></g></svg></span> 写在段落里。</p>
<div class="math display" data-tex="\\label{eq:chain}
\\frac{\\partial L}{\\partial x} = \\frac{\\partial L}{\\partial y} \\frac{\\partial y}{\\partial x}" id="eq-chain"><svg style="vertical-align: -2.017ex; min-width: 23.623ex;" xmlns="http://www.w3.org/2000/svg" width="100%" height="5.165ex" role="img" focusable="false" data-mjx-viewBox="0 -1391.5 10441.6 2283"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="scale(0.0181,-0.0181) translate(0, -1391.5)"><g data-mml-node="math"><g data-mml-node="mtable" transform="translate(2078,0) translate(-2078,0)"><g transform="translate(0 1391.5) matrix(1 0 0 -1 0 0) scale(55.25)"><svg data-table="true" preserveAspectRatio="xMidYMid" viewBox="3142.8 -1391.5 1 2283"><g transform="matrix(1 0 0 -1 0 0)"><g data-mml-node="mlabeledtr" transform="translate(0,-0.5)"><g data-mml-node="mtd"><g data-mml-node="mfrac"><g data-mml-node="mrow" transform="translate(220,676)"><g data-mml-node="mi"><use data-c="1D715" href="#MJX-NCM-I-1D715"></use></g><g data-mml-node="mi" transform="translate(566,0)"><use data-c="1D43F" href="#MJX-NCM-I-1D43F"></use></g></g><g data-mml-node="mrow" transform="translate(274.5,-686)"><g data-mml-node="mi"><use data-c="1D715" href="#MJX-NCM-I-1D715"></use></g><g data-mml-node="mi" transform="translate(566,0)"><use data-c="1D465" href="#MJX-NCM-I-1D465"></use></g></g><rect width="1447" height="60" x="120" y="220"></rect></g><g data-mml-node="mo" transform="translate(1964.8,0)"><use data-c="3D" href="#MJX-NCM-N-3D"></use></g><g data-mml-node="mfrac" transform="translate(3020.6,0)"><g data-mml-node="mrow" transform="translate(220,676)"><g data-mml-node="mi"><use data-c="1D715" href="#MJX-NCM-I-1D715"></use></g><g data-mml-node="mi" transform="translate(566,0)"><use data-c="1D43F" href="#MJX-NCM-I-1D43F"></use></g></g><g data-mml-node="mrow" transform="translate(315.5,-686)"><g data-mml-node="mi"><use data-c="1D715" href="#MJX-NCM-I-1D715"></use></g><g data-mml-node="mi" transform="translate(566,0)"><use data-c="1D466" href="#MJX-NCM-I-1D466"></use></g></g><rect width="1447" height="60" x="120" y="220"></rect></g><g data-mml-node="mfrac" transform="translate(4707.6,0)"><g data-mml-node="mrow" transform="translate(261,676)"><g data-mml-node="mi"><use data-c="1D715" href="#MJX-NCM-I-1D715"></use></g><g data-mml-node="mi" transform="translate(566,0)"><use data-c="1D466" href="#MJX-NCM-I-1D466"></use></g></g><g data-mml-node="mrow" transform="translate(220,-686)"><g data-mml-node="mi"><use data-c="1D715" href="#MJX-NCM-I-1D715"></use></g><g data-mml-node="mi" transform="translate(566,0)"><use data-c="1D465" href="#MJX-NCM-I-1D465"></use></g></g><rect width="1338" height="60" x="120" y="220"></rect></g></g></g></g></svg><svg data-labels="true" preserveAspectRatio="xMaxYMid" viewBox="1278 -1391.5 1 2283"><g data-labels="true" transform="matrix(1 0 0 -1 0 0)"><g data-mml-node="mtd" id="mjx-eqn:1" transform="translate(0,747.5)"><text data-id-align="true"></text><g data-idbox="true" transform="translate(0,-748)"><g data-mml-node="mtext"><use data-c="28" href="#MJX-NCM-N-28"></use></g><g data-mml-node="mtext" transform="translate(389,0)"><use data-c="31" href="#MJX-NCM-N-31"></use></g><g data-mml-node="mtext" transform="translate(889,0)"><use data-c="29" href="#MJX-NCM-N-29"></use></g></g></g></g></svg></g></g></g></g></svg></div>

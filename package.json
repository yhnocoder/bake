{
  "name": "@yhnocoder/bake",
  "version": "0.1.0",
  "description": "A static site generator for technical blogs with math, sidenotes and interactive components",
  "keywords": [
    "static-site-generator",
    "blog",
    "markdown",
    "mathjax",
    "web-components"
  ],
  "license": "MIT",
  "author": "yhnocoder",
  "homepage": "https://github.com/yhnocoder/bake#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhnocoder/bake.git"
  },
  "bugs": "https://github.com/yhnocoder/bake/issues",
  "type": "module",
  "bin": {
    "bake": "src/cli.js"
  },
  "files": [
    "src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "node --test --test-timeout=120000 \"test/browser/*.test.js\"",
    "test:frames": "node --test \"test/frames/*.test.js\""
  },
  "dependencies": {
    "@mathjax/src": "^4.1.3",
    "acorn": "^8.19.0",
    "fastest-levenshtein": "^1.0.16",
    "get-east-asian-width": "^1.7.0",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "html-url-attributes": "^3.0.1",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "micromark": "^4.0.3",
    "micromark-extension-cjk-friendly-util": "^3.0.1",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-chunked": "^2.0.1",
    "micromark-util-normalize-identifier": "^2.0.1",
    "micromark-util-resolve-all": "^2.0.1",
    "mime": "^4.1.1",
    "playwright": "1.56.1",
    "remark-cjk-friendly": "^2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "solid-js": "^1.9.17",
    "stringify-entities": "^4.0.4",
    "unified": "^11.0.5",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "lxgw-wenkai-webfont": "^1.7.0"
  }
}
